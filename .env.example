# Variables de entorno para despliegue en Hostinger (Node.js)
# Clave privada para la API externa (nunca se expone en el frontend ni en el navegador)
API_KEY=
# Puerto en el que escucha el servidor Node.js (Hostinger lo inyecta automáticamente vía process.env.PORT)
PORT=
# URL de la API externa (opcional si se utiliza el endpoint predeterminado)
EXTERNAL_API_URL=https://generativelanguage.googleapis.com/v1beta/models
# Tipo de encabezado de autenticación: bearer | x-api-key | x-goog-api-key (opcional)
EXTERNAL_API_AUTH_TYPE=bearer
